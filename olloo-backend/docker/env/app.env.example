# Container environment. Copy to app.env and edit; it is never committed.
#
# Only what differs from a stock Laravel install. Everything else comes from the
# image defaults, and the full list of what the app reads is in .env.example.
#
# Three rules that are easy to get wrong here:
#
#  1. DB_HOST must be host.docker.internal. MySQL is on the host, not in Docker.
#  2. APP_KEY must be the same across releases. Staff 2FA secrets and recovery
#     codes are encrypted with it, so a different key locks out every account
#     that has 2FA enabled. Copy it from the existing production .env the first
#     time you set this up.
#  3. ADMIN_PATH_PREFIX must not be blank. See the note by it below.

APP_NAME="H&CO API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The public origin of the API, and the storefront is served at / on it, so the two
# are the same string. Not a path prefix: these are origins.
APP_URL=https://hcomall.com
# Where the gateway bounces a shopper after a payment provider returns. Absolute, and
# never inferred. Same origin as APP_URL because the storefront is served here; it is
# still a separate setting, because it answers a different question.
WEB_CLIENT_URL=https://hcomall.com

LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_STACK=daily

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=handco
DB_USERNAME=handco
DB_PASSWORD=

# Database-backed on purpose: no Redis in this stack, so releases have no shared
# cache to invalidate and nothing to lose on a rollback.
#
# QUEUE_CONNECTION must not be `sync` here. The stack runs a dedicated queue
# container and a scheduler container, so `sync` does not remove the work, it
# moves it onto shoppers: a payment webhook would do settlement and outbound mail
# before returning, and orders:expire-unpaid would run inside an unrelated page
# load. Retry semantics disappear too. See docs/DEPLOYING.md.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@handco.craftsmanjohn.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required behind Cloudflare or any proxy, otherwise every visitor looks like the
# proxy and ShopperLocale places them all in the same country.
TRUSTED_PROXIES=

# Admin portal. The prefix is the only obscurity in front of the staff portal, so
# change it before go-live to something that is not in this repository.
#
# It must be a single path segment: no slashes, no leading dash. The gateway
# templates this same value into `location ^~ /<prefix>/`, so an empty value makes
# the container refuse to start and a value with a slash produces a directive that
# parses but never matches, which looks like a 404 on every admin URL. App\Support\
# EnvGuard rejects all of those at boot and names this key.
ADMIN_PATH_PREFIX=x7k9mPq2vL5nJw
ADMIN_MFA_FORCED=true

# Country detection for guests. Blank turns IP detection off entirely and every
# guest falls back to the default currency's country.
IPINFO_TOKEN=
CURRENCY_DEFAULT_MARKUP_PERCENT=0

# Payments. Routing is per currency in the database, never configured here.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=
STRIPE_CANCEL_RETURN_URL=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_RETURN_URL=
PAYSTACK_CANCEL_RETURN_URL=

# Where the storefront build is published on the host. The gateway bind-mounts it
# read-only at /var/www/html/web and serves it at /, so the storefront and the API
# share an origin and no CORS is involved.
#
# Publish a build with:
#   docker/scripts/publish-web.sh <frontend-build-dir> --web-root <this path>
#
# It must be a host path under /var/www/handco/shared, not a named volume. Compose
# namespaces named volumes per project and release.sh gives blue and green
# different project names, so a named volume would give each colour its own
# storefront and a rollback would silently serve the wrong build.
WEB_ROOT=/var/www/handco/shared/web
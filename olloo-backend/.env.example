APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
WEB_CLIENT_URL=http://localhost:5173
# Where gateway returns bounce the shopper. We verify the payment, then redirect
# here with our reference so the storefront can render the result.
WEB_CLIENT_RETURN_PATH=/checkout/return
WEB_CLIENT_CANCEL_PATH=/checkout/cancel

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vite dev server. The admin is served over HTTPS, so the dev server must be
# HTTPS too or the browser blocks the assets as mixed content. Copy the
# Let's Encrypt pair for APP_URL out of /etc/letsencrypt into ./ssl/ (gitignored):
#   sudo cp /etc/letsencrypt/live/<host>/{privkey,fullchain}.pem ssl/
VITE_HOST=handco.craftsmanjohn.com
VITE_HTTPS=true
VITE_SSL_KEY="./ssl/privkey.pem"
VITE_SSL_CERT="./ssl/fullchain.pem"

# olloo
APP_NAME="olloo"
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

PAYMENTS_ORDER_PAYMENT_WINDOW_MINUTES=60
# Business days before dispatch for variants without their own handling time.
SHIPPING_DEFAULT_HANDLING_DAYS=1

# Country list sync (php artisan countries:sync). Key from https://restcountries.com/sign-up
RESTCOUNTRIES_API_KEY=

# Payment return URLs are per provider, the same way Google's OAuth redirect is
# its own setting: each gateway redirects the shopper back on its own and does
# not share a page. Paths are resolved against APP_URL; Stripe rejects a
# relative URL outright. Absolute URLs are used as-is.
STRIPE_RETURN_URL=/checkout/return/stripe
STRIPE_CANCEL_RETURN_URL=/checkout/cancel/stripe

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYSTACK_RETURN_URL=/checkout/return/paystack
PAYSTACK_CANCEL_RETURN_URL=/checkout/cancel/paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# PayPal Orders API (https://developer.paypal.com). Sandbox URLs are used while PAYPAL_SANDBOX=true.
PAYPAL_RETURN_URL=/checkout/return/paypal
PAYPAL_CANCEL_RETURN_URL=/checkout/cancel/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true

# Tabby (https://docs.tabby.ai). Base URL picks the region: https://api.tabby.ai (UAE) or https://api.tabby.sa (KSA).
TABBY_RETURN_URL=/checkout/return/tabby
TABBY_CANCEL_RETURN_URL=/checkout/cancel/tabby
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_BASE_URL=https://api.tabby.ai
# Static header value Tabby sends on webhooks (register it with title X-Webhook-Key). Empty skips the check.
TABBY_WEBHOOK_KEY=

# Tamara (https://docs.tamara.co). Sandbox default; production is https://api.tamara.co.
TAMARA_RETURN_URL=/checkout/return/tamara
TAMARA_CANCEL_RETURN_URL=/checkout/cancel/tamara
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
TAMARA_BASE_URL=https://api-sandbox.tamara.co

# Google OAuth (storefront API). Redirect URL is the web client callback page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL="${WEB_CLIENT_URL}/oauth/google/callback"

ADMIN_PATH_PREFIX=hx7k9mPq2vL5nJw
ADMIN_MFA_FORCED=true
# Rows per page on every admin list.
ADMIN_PER_PAGE=50

# Currencies: shoppers are priced and charged in their country's currency when
# it is in the currencies table with a rate younger than CURRENCY_MAX_RATE_AGE_HOURS.
# Rates refresh twice daily (`currency:update-rates`); blank key uses the keyless endpoint.
EXCHANGE_RATE_API_KEY=
CURRENCY_MAX_RATE_AGE_HOURS=36
# Used until staff save a default markup on the admin Currencies page.
CURRENCY_DEFAULT_MARKUP_PERCENT=0
# Market for shoppers nothing else places (no stored country, no usable IP, e.g.
# localhost or a blank IPINFO_TOKEN). Blank = the default currency's country (US).
SHOPPER_FALLBACK_COUNTRY=GH
# IP to country (ipinfo Lite, free for commercial use). Blank turns detection off.
IPINFO_TOKEN=
# Proxies in front of the app (comma list or *), so the visitor IP is read from X-Forwarded-For.
TRUSTED_PROXIES=

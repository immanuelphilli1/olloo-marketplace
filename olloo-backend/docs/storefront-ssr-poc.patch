diff --git a/src/ssr/initialData.ts b/src/ssr/initialData.ts
new file mode 100644
index 0000000..0aa3b90
--- /dev/null
+++ b/src/ssr/initialData.ts
@@ -0,0 +1,23 @@
+import { createContext, useContext } from 'react'
+import type { ApiProductDetailResponse } from '../api/types'
+
+/**
+ * Data the SSR server fetched before it rendered the page. The browser reads
+ * the same object back from `window.__HANDCO_INITIAL_DATA__`, so its first
+ * render matches the server HTML and hydration needs no refetch.
+ */
+export type InitialData = {
+  product?: { rid: string; response: ApiProductDetailResponse }
+}
+
+declare global {
+  interface Window {
+    __HANDCO_INITIAL_DATA__?: InitialData
+  }
+}
+
+export const InitialDataContext = createContext<InitialData>({})
+
+export function useInitialData(): InitialData {
+  return useContext(InitialDataContext)
+}

diff --git a/src/entry-server.tsx b/src/entry-server.tsx
new file mode 100644
index 0000000..f9c0ae9
--- /dev/null
+++ b/src/entry-server.tsx
@@ -0,0 +1,18 @@
+import { StrictMode } from 'react'
+import { renderToString } from 'react-dom/server'
+import { StaticRouter } from 'react-router-dom'
+import { AppShell } from './App'
+import { InitialDataContext, type InitialData } from './ssr/initialData'
+
+/** Called by server/ssr.mjs for each SSR route. Pure: no fetching here. */
+export function render(url: string, initialData: InitialData): string {
+  return renderToString(
+    <StrictMode>
+      <InitialDataContext.Provider value={initialData}>
+        <StaticRouter location={url}>
+          <AppShell />
+        </StaticRouter>
+      </InitialDataContext.Provider>
+    </StrictMode>,
+  )
+}

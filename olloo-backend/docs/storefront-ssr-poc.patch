index 0000000..7d4c92e
--- /dev/null
+++ b/server/ssr.mjs
@@ -0,0 +1,132 @@
+// SSR server for the storefront. Node built-ins only, no framework.
+//
+//   node server/ssr.mjs        (after `npm run build:ssr`)
+//
+// Env:
+//   PORT              listen port (default 5180)
+//   SSR_API_BASE_URL  API base the server calls, e.g. http://app/api/v1 inside
+//                     Docker. Server to server: never the public URL if a
+//                     private one exists.
+//
+// Server-rendered routes: /products/:rid (proof of concept). Every other path
+// gets the plain SPA shell, exactly as nginx serves it today. Any SSR failure
+// also falls back to the plain shell, so SSR can cost speed, never the page.
+import { createServer } from 'node:http'
+import { readFile, stat } from 'node:fs/promises'
+import { extname, join, normalize } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = fileURLToPath(new URL('../dist/', import.meta.url))
+const clientDir = join(root, 'client')
+const PORT = Number(process.env.PORT ?? 5180)
+const API = (process.env.SSR_API_BASE_URL ?? '').replace(/\/$/, '')
+if (!/^https?:\/\//.test(API)) {
+  throw new Error('SSR_API_BASE_URL must be an absolute http(s) URL, for example http://app/api/v1')
+}
+
+const template = await readFile(join(clientDir, 'index.html'), 'utf8')
+if (!template.includes('<div id="root"></div>') || !template.includes('</head>')) {
+  throw new Error('dist/client/index.html needs <div id="root"></div> and </head>')
+}
+const { render } = await import(join(root, 'server', 'entry-server.js'))
+
+const TYPES = {
+  '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.png': 'image/png',
+  '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.ico': 'image/x-icon',
+  '.mp4': 'video/mp4', '.json': 'application/json', '.woff2': 'font/woff2', '.txt': 'text/plain',
+}
+
+async function api(path, clientIp) {
+  // ponytail: no timeout tuning or retries; a slow API means the plain shell after 3 s.
+  const response = await fetch(`${API}${path}`, {
+    headers: { Accept: 'application/json', 'X-Forwarded-For': clientIp },
+    signal: AbortSignal.timeout(3000),
+  })
+  return { status: response.status, body: response.ok ? await response.json() : null }
+}
+
+/** Escapes text for HTML attributes and text nodes. */
+const esc = (value) =>
+  String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+
+/** JSON safe inside <script>: no "</script>", no "<!--". */
+const scriptJson = (value) => JSON.stringify(value).replace(/</g, '\\u003c')
+
+/** Same tags the Laravel StorefrontPageController writes, from GET /seo. */
+function headTags(meta) {
+  const tag = (attr, key, value) => (value ? `<meta ${attr}="${key}" content="${esc(value)}" data-seo>` : '')
+  return [
+    `<title data-seo>${esc(meta.title)}</title>`,
+    tag('name', 'description', meta.description),
+    tag('name', 'robots', meta.robots),
+    `<link rel="canonical" href="${esc(meta.canonical)}" data-seo>`,
+    tag('property', 'og:type', meta.type),
+    tag('property', 'og:title', meta.title),
+    tag('property', 'og:description', meta.description),
+    tag('property', 'og:url', meta.canonical),
+    tag('property', 'og:image', meta.image),
+    tag('name', 'twitter:card', meta.image ? 'summary_large_image' : 'summary'),
+    ...meta.jsonLd.map((data) => `<script type="application/ld+json" data-seo>${scriptJson(data)}</script>`),
+  ].join('\n')
+}
+
+function page({ head = '', appHtml = '', initialData }) {
+  let html = template
+  if (head) {
+    html = html.replace(/<title\b[^>]*>[\s\S]*?<\/title>\s*/i, '')
+    html = html.replace(/<meta\s[^>]*name="description"[^>]*>\s*/i, '')
+    html = html.replace('</head>', () => `${head}\n</head>`)
+  }
+  if (appHtml) {
+    const data = `<script>window.__HANDCO_INITIAL_DATA__=${scriptJson(initialData)}</script>`
+    // Functions, not strings: a "$&" in a product name must not become a regex token.
+    html = html.replace('<div id="root"></div>', () => `<div id="root">${appHtml}</div>${data}`)
+  }
+  return html
+}
+
+async function renderProduct(url, rid, clientIp) {
+  const [detail, seo] = await Promise.all([
+    api(`/products/${encodeURIComponent(rid)}`, clientIp),
+    api(`/seo?path=${encodeURIComponent(new URL(url, 'http://x').pathname)}`, clientIp),
+  ])
+  const head = seo.body ? headTags(seo.body) : ''
+  if (!detail.body) {
+    // Unknown product: real 404 status, plain shell; the app shows its own screen.
+    return { status: detail.status === 404 ? 404 : 502, html: page({ head }) }
+  }
+  const initialData = { product: { rid, response: detail.body } }
+  return { status: 200, html: page({ head, appHtml: render(url, initialData), initialData }) }
+}
+
+async function serveStatic(pathname, res) {
+  const file = normalize(join(clientDir, decodeURIComponent(pathname)))
+  if (!file.startsWith(clientDir) || pathname === '/' || pathname.endsWith('.html')) return false
+  const info = await stat(file).catch(() => null)
+  if (!info?.isFile()) return false
+  res.writeHead(200, {
+    'Content-Type': TYPES[extname(file)] ?? 'application/octet-stream',
+    'Cache-Control': pathname.startsWith('/assets/') ? 'public, max-age=31536000, immutable' : 'public, max-age=3600',
+  })
+  res.end(await readFile(file))
+  return true
+}
+
+createServer(async (req, res) => {
+  const url = req.url ?? '/'
+  const { pathname } = new URL(url, 'http://x')
+  const clientIp = String(req.headers['x-forwarded-for'] ?? req.socket.remoteAddress ?? '').split(',')[0].trim()
+  try {
+    if (await serveStatic(pathname, res)) return
+
+    const product = pathname.match(/^\/products\/([^/]+)$/)
+    const result = product ? await renderProduct(url, decodeURIComponent(product[1]), clientIp) : null
+
+    res.writeHead(result?.status ?? 200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' })
+    res.end(result?.html ?? template)
+  } catch (error) {
+    console.error(`[ssr] ${pathname}:`, error)
+    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' })
+    res.end(template)
+  }
+}).listen(PORT, () => console.log(`[ssr] listening on :${PORT}, API ${API}`))

      "targetPort": "__trigger__"
    }
  ],
  "environment": [
    {
      "id": "NEW_ID:baseUrl",
      "name": "baseUrl",
      "description": "HandCO API root (e.g. http://127.0.0.1:8000/api/v1)",
      "color": "blue",
      "type": "string"
    },
    {
      "id": "NEW_ID:categoryRid",
      "name": "categoryRid",
      "description": "Category rid for catalog browsing (seed default: electronics)",
      "color": "green",
      "type": "string"
    }
  ]
}

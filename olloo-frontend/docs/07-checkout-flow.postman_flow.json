  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"jaygrey.jg@gmail.com\",\n  \"password\": \"password\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const j = pm.response.json();",
              "  const access = j.accessToken || (j.data && j.data.accessToken);",
              "  const refresh = j.refreshToken || (j.data && j.data.refreshToken);",
              "  const user = j.user || (j.data && j.data.user);",
              "  if (access) {",
              "    pm.collectionVariables.set('accessToken', access);",
              "    pm.environment.set('accessToken', access);",
              "  }",
              "  if (refresh) {",
              "    pm.collectionVariables.set('refreshToken', refresh);",
              "    pm.environment.set('refreshToken', refresh);",
              "  }",
              "  if (user && user.rid) {",
              "    pm.collectionVariables.set('userRid', user.rid);",
              "    pm.environment.set('userRid', user.rid);",
              "  }",
              "}",
              "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ]
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/products?page=1&limit=20&categoryId=electronics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "categoryId",
              "value": "electronics"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  const items = j.items || [];",
              "  if (items[0] && items[0].rid) pm.collectionVariables.set('productRid', items[0].rid);",
              "}",
              "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));"
            ]
          }
        }
      ]
    },

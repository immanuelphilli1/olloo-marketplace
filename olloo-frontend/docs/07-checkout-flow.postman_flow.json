        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.product && j.product.variants && j.product.variants[0]) {",
              "    pm.collectionVariables.set('variantRid', j.product.variants[0].rid);",
              "  }",
              "}",
              "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));"
            ]
          }
        }
      ]
    },

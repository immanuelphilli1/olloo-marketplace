        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cartRid = pm.response.headers.get('X-Cart-Id');",
              "if (cartRid) pm.collectionVariables.set('cartRid', cartRid);",
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.items && j.items[0]) {",
              "    pm.collectionVariables.set('cartItemRid', j.items[0].rid);",
              "  }",
              "}",
              "pm.test('status ok', () => pm.expect(pm.response.code).to.eql(200));"
